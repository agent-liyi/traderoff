# Required for market data refreshes.
TUSHARE_TOKEN=your_tushare_token

# Required by the bundled PostgreSQL 16 + pgvector service. Use a URL-safe
# random value; do not use a password containing @, :, /, ?, #, or %.
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Public hostname used by Caddy for HTTPS.
# Use localhost for local development. In production, point this domain's A/AAAA record to the server.
TRADEROFF_DOMAIN=localhost

# Tencent Cloud SES (email verification-code login). Required in production.
SES_SECRET_ID=
SES_SECRET_KEY=
SES_FROM_EMAIL_ADDRESS=

# Reveal the verification code in the /api/auth/email/send response (dev only).
SES_DEV_REVEAL=0

# The application receives this automatically when using docker-compose.yml.
# Set it only for a separate local process or an external PostgreSQL service.
# MARKET_DATABASE_URL=postgresql://traderoff:password@localhost:5432/traderoff
