# Required for market data refreshes.
TUSHARE_TOKEN=your_tushare_token

# Public hostname used by Caddy for HTTPS and WeChat OAuth callbacks.
# Use localhost for local development. In production, point this domain's A/AAAA record to the server.
TRADEROFF_DOMAIN=localhost

# Development mode simulates WeChat authentication locally.
WECHAT_AUTH_MODE=development

# Required when WECHAT_AUTH_MODE=production.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.example/api/auth/wechat/callback
