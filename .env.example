# Required for market data refreshes.
TUSHARE_TOKEN=your_tushare_token

# Development mode simulates WeChat authentication locally.
WECHAT_AUTH_MODE=development

# Required when WECHAT_AUTH_MODE=production.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8788/api/auth/wechat/callback
